{
  "name": "@chaoxu/coflat-editor",
  "version": "0.1.13",
  "description": "Math-aware markdown editor library extracted from coflat — CM6 + Lezer + Typora-style ViewPlugins.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "files": [
    "dist",
    "patches"
  ],
  "exports": {
    ".": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.mjs"
    },
    "./citeproc": {
      "types": "./dist/citeproc.d.ts",
      "import": "./dist/citeproc.mjs"
    },
    "./test-utils": {
      "types": "./dist/src/test-utils.d.ts",
      "import": "./dist/src/test-utils.js"
    },
    "./style.css": "./dist/editor.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.editor.json && vite build --config vite.editor.config.ts && rsync -aR src/**/*.d.mts dist/ && rsync -aR src/**/*.d.ts dist/ && tsc -p tsconfig.test-utils.json && cp src/test-utils.ts dist/src/test-utils.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "prepack": "pnpm build"
  },
  "publishConfig": {
    "registry": "http://localhost:3001/api/packages/chaoxu/npm/"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "patchedDependencies": {
      "katex@0.16.38": "patches/katex@0.16.38.patch",
      "@lezer/markdown@1.6.3": "patches/@lezer__markdown@1.6.3.patch"
    }
  },
  "peerDependencies": {
    "@citation-js/core": "^0.7.21",
    "@citation-js/plugin-bibtex": "^0.7.21",
    "@citation-js/plugin-csl": "^0.7.22",
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.12.2",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.40.0",
    "@floating-ui/dom": "^1.7.6",
    "@lezer/common": "^1.5.1",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.1",
    "katex": "0.16.38",
    "lucide-react": "^0.577.0",
    "pathe": "^2.0.3",
    "pdfjs-dist": "^5.5.207",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "yaml": "^2.8.3",
    "zustand": "^5.0.12"
  },
  "dependencies": {
    "@overleaf/codemirror-tree-view": "^0.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.0.5",
    "@types/katex": "^0.16.8",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "fast-check": "^4.6.0",
    "jsdom": "^29.0.0",
    "publint": "^0.3.18",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.9",
    "vitest": "^4.1.0"
  }
}
